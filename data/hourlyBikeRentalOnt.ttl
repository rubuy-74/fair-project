#################################################################

###  https://w3id.org/FAIR-course-UT/2026/group20/ont#hourlyBikeRental
:hourlyBikeRental rdf:type owl:DatatypeProperty ;
                  rdfs:range xsd:nonNegativeInteger ;
                  rdfs:comment "Count of bicycle rentals in 1 hour." ;
                  rdfs:label "Hourly bicycle rental count" .