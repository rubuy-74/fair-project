@prefix lbd:     <https://w3id.org/london-bike-sharing/> .
@prefix dcat:    <http://www.w3.org/ns/dcat#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix csvw:    <http://www.w3.org/ns/csvw#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix spdx:    <http://spdx.org/rdf/terms#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .

lbd:londonBikeSharingDataset a dcat:Dataset ;
    dcterms:identifier "london-bike-sharing-dataset" ;
    dcterms:title "London bike sharing dataset"@en ;
    dcterms:description "Historical data for bike sharing in London: hourly counts of new bike-share hires combined with weather observations (air temperature, apparent temperature, relative humidity, wind speed, coded weather condition), UK bank holiday and weekend flags, and meteorological season, covering 2015-01-04 to 2017-01-03. Powered by TfL Open Data."@en ;
    dcterms:creator [
        a dcterms:Agent ;
        rdfs:label "Hristo Mavrodiev"
    ] ;
    dcterms:license [
        a dcterms:LicenseDocument ;
        rdfs:label "TfL Open Data Licence"@en
    ] ;
    dcterms:temporal [
        a dcterms:PeriodOfTime ;
        dcat:startDate "2015-01-04T00:00:00"^^xsd:dateTime ;
        dcat:endDate "2017-01-03T23:00:00"^^xsd:dateTime
    ] ;
    dcat:landingPage <https://www.kaggle.com/datasets/hmavrodiev/london-bike-sharing-dataset> ;
    dcterms:source <https://cycling.data.tfl.gov.uk/> , <https://www.gov.uk/bank-holidays> , <https://freemeteo.com> ;
    dcat:keyword "bike sharing" , "London" , "transport" , "weather" , "time series" ;
    dcat:distribution lbd:londonMergedCsvDistribution .

lbd:londonMergedCsvDistribution a dcat:Distribution, csvw:Table ;
    rdfs:label "london_merged.csv"@en ;
    dcat:accessURL <https://www.kaggle.com/datasets/hmavrodiev/london-bike-sharing-dataset/data> ;
    dcat:mediaType "text/csv" ;
    dcat:byteSize 1034821 ;
    spdx:checksum [
        a spdx:Checksum ;
        spdx:algorithm spdx:checksumAlgorithm_sha256 ;
        spdx:checksumValue "db881c26314329377f81265480856f2fe4fb049fc1e79bd5f548813c99c4c446"^^xsd:hexBinary
    ] ;
    csvw:tableSchema lbd:londonMergedCsvSchema .
