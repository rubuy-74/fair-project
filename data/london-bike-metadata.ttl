@prefix lbd:     <https://w3id.org/london-bike-sharing/> .
@prefix dcat:    <http://www.w3.org/ns/dcat#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix spdx:    <http://spdx.org/rdf/terms#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .

lbd:londonBikeSharingDataset a dcat:Dataset ;
    dcterms:identifier "london-bike-sharing-dataset" ;
    dcterms:title "London bike sharing dataset"@en ;
    dcterms:description "Historical data for bike sharing in London: hourly counts of new bike-share hires combined with weather observations (air temperature, apparent temperature, relative humidity, wind speed, coded weather condition), UK bank holiday and weekend flags, and meteorological season, covering 2015-01-04 to 2017-01-03. Powered by TfL Open Data."@en ;
    dcterms:creator [
        a dcterms:Agent ;
        rdfs:label "Hristo Mavrodiev"
    ] ;
    dcterms:rights [
        a dcterms:RightsStatement ;
        rdfs:label "Rights for the combined dataset are not fully established"@en ;
        dcterms:description "Kaggle labels the licence 'Other (specified in description)' and reproduces TfL Transport Data Service terms. Those terms concern TfL information; permission for the combined dataset, including Freemeteo weather data, has not been verified. No blanket reuse licence is asserted here. Powered by TfL Open Data."@en ;
        dcterms:source <https://www.kaggle.com/datasets/hmavrodiev/london-bike-sharing-dataset>, <https://tfl.gov.uk/corporate/terms-and-conditions/transport-data-service>
    ] ;
    dcterms:temporal [
        a dcterms:PeriodOfTime ;
        dcat:startDate "2015-01-04T00:00:00"^^xsd:dateTime ;
        dcat:endDate "2017-01-03T23:00:00"^^xsd:dateTime
    ] ;
    dcat:landingPage <https://www.kaggle.com/datasets/hmavrodiev/london-bike-sharing-dataset> ;
    dcterms:source <https://www.kaggle.com/datasets/hmavrodiev/london-bike-sharing-dataset>, <https://cycling.data.tfl.gov.uk/> , <https://www.gov.uk/bank-holidays> , <https://freemeteo.com> ;
    dcterms:provenance [
        a dcterms:ProvenanceStatement ;
        rdfs:label "The Kaggle description attributes the compilation to Hristo Mavrodiev and identifies TfL cycling data, Freemeteo weather data and UK bank holidays as sources. Bike hires are grouped by start hour. Timestamp timezone is not specified by the checked Kaggle description; no UTC or daylight-saving interpretation is asserted."@en
    ] ;
    dcat:keyword "bike sharing" , "London" , "transport" , "weather" , "time series" ;
    dcat:distribution lbd:londonMergedCsvDistribution, lbd:londonBikesRdfDistribution .

lbd:londonMergedCsvDistribution a dcat:Distribution ;
    rdfs:label "london_merged.csv"@en ;
    dcat:accessURL <https://www.kaggle.com/datasets/hmavrodiev/london-bike-sharing-dataset/data> ;
    dcat:mediaType "text/csv" ;
    dcat:byteSize 1034821 ;
    spdx:checksum [
        a spdx:Checksum ;
        spdx:algorithm spdx:checksumAlgorithm_sha256 ;
        spdx:checksumValue "db881c26314329377f81265480856f2fe4fb049fc1e79bd5f548813c99c4c446"^^xsd:hexBinary
    ] .

# Local artifact only. Add publication URLs only after deployment, and refresh
# byte size and SHA-256 only after the final concurrent RDF edits are complete.
lbd:londonBikesRdfDistribution a dcat:Distribution ;
    rdfs:label "london_bikes.ttl"@en ;
    dcterms:description "Local RDF artifact at data/london_bikes.ttl. No public download endpoint is asserted. Byte size and SHA-256 must be added after the final RDF changes."@en ;
    dcterms:identifier "data/london_bikes.ttl" ;
    dcterms:format <http://www.w3.org/ns/formats/Turtle> ;
    dcterms:conformsTo <https://www.w3.org/TR/turtle/> ;
    dcat:mediaType "text/turtle" .
