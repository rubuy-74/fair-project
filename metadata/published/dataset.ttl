<https://w3id.org/FAIR-course-UT/2026/group20/group> a foaf:Agent;
  foaf:name "FAIR course group 20 - Rubem Neto and Pedro Oliveira" .

<https://w3id.org/FAIR-course-UT/2026/group20/rights/combined-dataset> a dcterms:RightsStatement;
  <http://www.w3.org/2000/01/rdf-schema#label> "Rights for the combined dataset are not fully established"@en;
  dcterms:description "Kaggle labels the licence 'Other (specified in description)' and reproduces TfL Transport Data Service terms. Those terms concern TfL information; permission for the combined dataset, including Freemeteo weather data, has not been verified. No blanket reuse licence is asserted here. Powered by TfL Open Data."@en;
  dcterms:source <https://tfl.gov.uk/corporate/terms-and-conditions/transport-data-service>,
    <https://www.kaggle.com/datasets/hmavrodiev/london-bike-sharing-dataset> .

<https://w3id.org/FAIR-course-UT/2026/group20/fdp/dataset/8c23e51f-cc3a-4fa3-a0f4-ee553dcfbc7e>
  a dcat:Resource, dcat:Dataset;
  <http://www.w3.org/2000/01/rdf-schema#label> "London bike sharing dataset";
  dcterms:title "London bike sharing dataset"@en;
  dcat:version "1.0.0";
  <https://w3id.org/fdp/fdp-o#metadataIssued> "2026-10-24T17:43:11.421629077Z"^^xsd:dateTime;
  <https://w3id.org/fdp/fdp-o#metadataModified> "2026-10-24T18:00:52.68548638Z"^^xsd:dateTime;
  dcterms:license <http://spdx.org/rdf/terms#noassertion>;
  dcterms:description "Historical data for bike sharing in London: hourly counts of new bike-share hires combined with weather observations (air temperature, apparent temperature, relative humidity, wind speed, coded weather condition), UK bank holiday and weekend flags, and meteorological season, covering 2015-01-04 to 2017-01-03. Powered by TfL Open Data."@en;
  dcterms:language <http://id.loc.gov/vocabulary/iso639-1/en>;
  <https://w3id.org/fdp/fdp-o#metadataIdentifier> <https://w3id.org/FAIR-course-UT/2026/group20/fdp/dataset/8c23e51f-cc3a-4fa3-a0f4-ee553dcfbc7e#identifier>;
  dcterms:identifier "london-bike-sharing-dataset";
  dcterms:accessRights <https://w3id.org/FAIR-course-UT/2026/group20/fdp/dataset/8c23e51f-cc3a-4fa3-a0f4-ee553dcfbc7e#accessRights>;
  dcterms:publisher <https://w3id.org/FAIR-course-UT/2026/group20/group>;
  <http://semanticscience.org/resource/SIO_000628> <https://w3id.org/FAIR-course-UT/2026/group20/fdp/dataset/8c23e51f-cc3a-4fa3-a0f4-ee553dcfbc7e/metrics/445c0a70d1e214e545b261559e2842f4>,
    <https://w3id.org/FAIR-course-UT/2026/group20/fdp/dataset/8c23e51f-cc3a-4fa3-a0f4-ee553dcfbc7e/metrics/5d27e854a9e78eb3f663331cd47cdc13>;
  dcterms:isPartOf <https://w3id.org/FAIR-course-UT/2026/group20/fdp/catalog/c61b6da8-bf15-44dd-ba4b-121669ff6751>;
  dcterms:source <https://www.kaggle.com/datasets/hmavrodiev/london-bike-sharing-dataset>,
    <https://cycling.data.tfl.gov.uk/>, <https://freemeteo.com>, <https://www.gov.uk/bank-holidays>;
  dcterms:contributor [ a dcterms:Agent;
      <http://www.w3.org/2000/01/rdf-schema#label> "Rubem Neto"
    ], [ a dcterms:Agent;
      <http://www.w3.org/2000/01/rdf-schema#label> "Pedro Oliveira"
    ];
  dcterms:creator [ a dcterms:Agent;
      <http://www.w3.org/2000/01/rdf-schema#label> "Hristo Mavrodiev"
    ];
  dcterms:provenance [ a dcterms:ProvenanceStatement;
      <http://www.w3.org/2000/01/rdf-schema#label> "The Kaggle description attributes the compilation to Hristo Mavrodiev and identifies TfL cycling data, Freemeteo weather data and UK bank holidays as sources. Bike hires are grouped by start hour. Rubem Neto and Pedro Oliveira performed the FAIRification. The source description does not specify a timezone; the RDF uses the teacher-approved minute-precision timestamp convention."@en
    ];
  dcterms:rights <https://w3id.org/FAIR-course-UT/2026/group20/rights/combined-dataset>;
  dcterms:temporal [ a dcterms:PeriodOfTime;
      dcat:endDate "2017-01-03T23:00:00"^^xsd:dateTime;
      dcat:startDate "2015-01-04T00:00:00"^^xsd:dateTime
    ];
  dcat:keyword "London", "bike sharing", "time series", "transport", "weather";
  dcat:landingPage <https://github.com/rubuy-74/fair-project>;
