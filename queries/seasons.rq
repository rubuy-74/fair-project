PREFIX schema: <http://schema.org/>
PREFIX obo: <http://purl.obolibrary.org/obo/>

# CQ5. Wrapper types use HTTP Wikidata IRIs; values use HTTPS IRIs.
SELECT ?season ?name (COUNT(*) AS ?hours) (SUM(?hires) AS ?totalHires)
       (AVG(?hires) AS ?meanHourlyHires) WHERE {
  VALUES (?season ?name) {
    (<https://www.wikidata.org/entity/Q1311> "winter")
    (<https://www.wikidata.org/entity/Q1312> "spring")
    (<https://www.wikidata.org/entity/Q1313> "summer")
    (<https://www.wikidata.org/entity/Q1314> "autumn")
  }
  ?relation a <http://www.wikidata.org/entity/Q24384> ; schema:value ?season .
  ?observation obo:RO_0002092 ?relation ; schema:measuredValue ?hires .
}
GROUP BY ?season ?name
ORDER BY ?season
