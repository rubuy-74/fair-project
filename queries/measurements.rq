PREFIX schema: <http://schema.org/>

# Widths are 5 Celsius, 10 percentage points, and 5 km/h, respectively.
SELECT ?measurement ?unit ?lower ?upper (COUNT(*) AS ?hours)
       (AVG(?hires) AS ?meanHourlyHires) WHERE {
  VALUES (?measurement ?width) {
    (<http://qudt.org/vocab/quantitykind/Temperature> 5)
    (<https://bimerr.iot.linkeddata.es/def/weather#feels_like> 5)
    (<https://bimerr.iot.linkeddata.es/def/weather#Humidity> 10)
    (<https://bimerr.iot.linkeddata.es/def/weather#WindSpeed> 5)
  }
  ?observation schema:value ?hires ;
               schema:additionalProperty ?attribute .
  ?attribute schema:propertyID ?measurement ; schema:value ?value ;
             schema:unitCode ?unit .
  BIND(FLOOR(?value / ?width) * ?width AS ?lower)
  BIND(?lower + ?width AS ?upper)
}
GROUP BY ?measurement ?unit ?lower ?upper
ORDER BY ?measurement ?lower
