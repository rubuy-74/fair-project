PREFIX base: <http://localhost:3333/>
PREFIX schema: <http://schema.org/>

# CQ6. Use the preserved CSV code, never reverse-map the lossy weather entity.
SELECT ?code (COUNT(*) AS ?hours) (SUM(?hires) AS ?totalHires)
       (AVG(?hires) AS ?meanHourlyHires) WHERE {
  ?observation a schema:Observation ; schema:measuredValue ?hires ;
               base:weather_code ?code .
}
GROUP BY ?code
ORDER BY ?code
