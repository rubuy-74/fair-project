PREFIX base: <http://localhost:3333/>
PREFIX schema: <http://schema.org/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

# CQ1. Change the example hour, or bind requestedHour in the local runner.
SELECT ?observation ?timestamp ?hires WHERE {
  BIND(COALESCE(?requestedHour, "2015-01-04T00:00:00"^^xsd:dateTime) AS ?hour)
  ?observation a schema:Observation ; base:timestamp ?timestamp ;
               schema:measuredValue ?hires .
  FILTER(?timestamp = ?hour)
}
ORDER BY ?observation
