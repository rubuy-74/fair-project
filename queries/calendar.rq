PREFIX schema: <http://schema.org/>
PREFIX wd: <https://www.wikidata.org/entity/>

# Each flag is analysed separately, not as a joint grouping.
SELECT ?flag ?value (COUNT(*) AS ?hours) (SUM(?hires) AS ?totalHires)
       (AVG(?hires) AS ?meanHourlyHires) WHERE {
  VALUES ?flag { wd:Q211391 wd:Q1445650 }
  ?observation schema:value ?hires ;
               schema:additionalProperty ?attribute .
  ?attribute schema:propertyID ?flag ; schema:value ?value .
}
GROUP BY ?flag ?value
ORDER BY ?flag ?value
